# API_KEY_OPENAI=your-openai-key
API_KEY_OPENAI=
# Default OpenAI model (used if model_name omitted)
OPENAI_MODEL=gpt-3.5-turbo
# REDTEAM_API_KEYS=my-local-test-key
HF_TOKEN=
DEVICE=cpu
OPENROUTER_API_KEY=
# Optional override if self-hosting OpenRouter-compatible gateway
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
# When request name lacks provider, use this default (openai|openrouter|huggingface)
DEFAULT_MODEL_PROVIDER=openrouter
# DSN settings (Don't-Say-No suffix generation)
DSN_BACKEND=
DSN_MODEL=
DSN_BASE_URL=
DSN_DRY_RUN=false
DSN_WHITEBOX=false
DSN_WHITEBOX_MODEL=distilgpt2
DSN_SUFFIX_TOKENS=20
DSN_MAX_STEPS=50
DSN_MAX_EXAMPLES=3
DSN_RESTARTS=2
# Optional: path to JSON/JSONL with {"query","target"} pairs
DSN_DATA_PATH=
# AART settings (prototype integration)
AART_BACKEND=
AART_MODEL=
AART_BASE_URL=
# Set to true to force offline/local generation when keys are unavailable
AART_DRY_RUN=false
# SAP settings (attack-prompt prototype integration)
SAP_ATTACKER_BACKEND=
SAP_TARGET_BACKEND=
SAP_EVALUATOR_BACKEND=
SAP_ATTACKER_MODEL=
SAP_TARGET_MODEL=
SAP_EVALUATOR_MODEL=
SAP_BASE_URL=
# Force offline/local SAP loop when keys are unavailable
SAP_DRY_RUN=false
# GPTFUZZER settings (prototype integration)
GPTFUZZER_BACKEND=openrouter
GPTFUZZER_MUTATE_MODEL=
GPTFUZZER_TARGET_MODEL=
GPTFUZZER_JUDGE_MODEL=
GPTFUZZER_BASE_URL=
GPTFUZZER_JUDGE_BASE_URL=
GPTFUZZER_JUDGE_API_KEY=
# Optional: pipe-separated questions to augment defaults
GPTFUZZER_HARMFUL_QUESTIONS=
# Set to true to force offline/local mutator instead of calling models
GPTFUZZER_DRY_RUN=false
